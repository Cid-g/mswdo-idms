# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/mswdo_idms

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_strong_random_secret_min_32_char

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── File Storage ──────────────────────────────────────────────
UPLOADS_DIR=./uploads

# ── Public Verification URL ───────────────────────────────────
VERIFICATION_BASE_URL=https://verify.mswdo-gerona.gov.ph/check

# ── Seed Accounts (used only by npm run seed) ─────────────────
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=Admin@1234!
SEED_SUPERADMIN_EMAIL=superadmin@mswdo-gerona.gov.ph

SEED_PWD_ADMIN_USERNAME=admin.pwd
SEED_PWD_ADMIN_PASSWORD=Admin@1234!
SEED_PWD_ADMIN_EMAIL=admin.pwd@mswdo-gerona.gov.ph

SEED_SP_ADMIN_USERNAME=admin.soloparent
SEED_SP_ADMIN_PASSWORD=Admin@1234!
SEED_SP_ADMIN_EMAIL=admin.sp@mswdo-gerona.gov.ph

SEED_SC_ADMIN_USERNAME=admin.seniorcitizen
SEED_SC_ADMIN_PASSWORD=Admin@1234!
SEED_SC_ADMIN_EMAIL=admin.sc@mswdo-gerona.gov.ph

# ── Hyperledger Fabric (Phase 11) ─────────────────────────────
# FABRIC_CHANNEL=mychannel
# FABRIC_CHAINCODE=id-contract
# FABRIC_MSP_ID=Org1MSP
# FABRIC_PEER_ENDPOINT=localhost:7051
# FABRIC_CERT_PATH=./fabric/certs/cert.pem
# FABRIC_KEY_PATH=./fabric/certs/key.pem
# FABRIC_TLS_CERT_PATH=./fabric/certs/tls.pem

# -- Outbound public-verification synchronization -----------------------------
# Production must explicitly set this to true or false. Keep false until the
# cloud verifier trusts VERIFICATION_SYNC_KEY_ID and the private key is mounted.
VERIFICATION_SYNC_ENABLED=false
VERIFICATION_SYNC_ORIGIN=https://verify.mswdo-gerona.gov.ph
VERIFICATION_SYNC_KEY_ID=office-key-2026-01
# Absolute path to an Ed25519 PKCS#8 private key. Never commit the key itself.
VERIFICATION_SYNC_PRIVATE_KEY_PATH=/run/secrets/mswdo-verification-ed25519.pem
VERIFY_PROTOCOL_AUDIENCE=mswdo-verification-service
VERIFY_SYNC_PATH=/internal/sync
VERIFICATION_SYNC_TIMEOUT_MS=10000
VERIFICATION_SYNC_WORKER_INTERVAL_MS=30000
