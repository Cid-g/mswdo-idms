# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/mswdo_idms

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_strong_random_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── File Storage ──────────────────────────────────────────────
UPLOADS_DIR=./uploads

# ── Public Verification URL ───────────────────────────────────
VERIFICATION_BASE_URL=http://localhost:5173/verify

# ── Seed Accounts (used only by npm run seed) ─────────────────
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=Admin@1234!
SEED_SUPERADMIN_EMAIL=superadmin@mswdo-gerona.gov.ph

SEED_PWD_ADMIN_USERNAME=admin.pwd
SEED_PWD_ADMIN_PASSWORD=Admin@1234!
SEED_PWD_ADMIN_EMAIL=admin.pwd@mswdo-gerona.gov.ph

SEED_SP_ADMIN_USERNAME=admin.soloparent
SEED_SP_ADMIN_PASSWORD=Admin@1234!
SEED_SP_ADMIN_EMAIL=admin.sp@mswdo-gerona.gov.ph

SEED_SC_ADMIN_USERNAME=admin.seniorcitizen
SEED_SC_ADMIN_PASSWORD=Admin@1234!
SEED_SC_ADMIN_EMAIL=admin.sc@mswdo-gerona.gov.ph

# ── Hyperledger Fabric (Phase 11) ─────────────────────────────
# Set FABRIC_ENABLED=false on presentation device if Fabric is not running
FABRIC_ENABLED=true

FABRIC_PEER_HOST=localhost
FABRIC_PEER_PORT=7051
FABRIC_PEER_NAME=peer0.org1.example.com
FABRIC_MSP_ID=Org1MSP
FABRIC_TLS_CERT_PATH=/home/cedrick/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
FABRIC_CERT_PATH=/home/cedrick/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/signcerts/cert.pem
FABRIC_PRIVATE_KEY_PATH=/home/cedrick/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/keystore/a2d281d7e440119874a76136fe77139f1f4ba4608845c8c6d31373ff02b3f2dc_sk
