# Cloud verification service only. Never place the office private signing key here.
MONGODB_URI=mongodb://127.0.0.1:27017
VERIFY_MONGODB_DATABASE=mswdo_verification

# JSON object: key ID -> Ed25519 PUBLIC key in PEM format. Encode PEM newlines as \n.
VERIFY_PUBLIC_KEYS={"office-dev-1":"-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_ED25519_PUBLIC_KEY\n-----END PUBLIC KEY-----\n"}

HOST=0.0.0.0
PORT=3002
VERIFY_PROTOCOL_AUDIENCE=mswdo-verification-service
VERIFY_SYNC_PATH=/internal/sync
VERIFY_HEALTH_PATH=/internal/health
VERIFY_CHECK_PATH=/check
VERIFY_MAX_REQUEST_AGE_MS=300000
VERIFY_MAX_SYNC_AGE_MS=300000
VERIFY_MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
VERIFY_SHUTDOWN_GRACE_MS=10000

# Public /check in-process abuse controls. A distributed edge/WAF limit is still required.
VERIFY_RATE_LIMIT_WINDOW_MS=60000
VERIFY_RATE_LIMIT_IP_MAX=30
VERIFY_RATE_LIMIT_TOKEN_MAX=10
VERIFY_RATE_LIMIT_GLOBAL_MAX=600
VERIFY_RATE_LIMIT_MAX_KEYS=10000
